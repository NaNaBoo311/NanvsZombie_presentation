class_name NavGrid
extends RefCounted

# NavGrid — walking routes for enemies that spawn in a map's regions and walk to the lawn
# around water, buildings, trees and fences (CONTRACT(add-map) nav_path). Replaces the
# hand-authored spawn gates: nothing is authored per route, only per map.
#
#   data/maps/<map_id>/nav.json       authored: {cell, bounds [x0, z0, x1, z1], regions
#                                     {name: [x, z, w, d]}, bridges [{name, half_w, deck
#                                     [[x, z, y]...]}], hash_inputs [res:// paths]}
#   data/maps/<map_id>/nav_grid.json  generated by `-- --nav-bake`: {hash, rows} - one
#                                     "0"/"1" string per grid row, 1 = an enemy fits.
#
# A cell is walkable unless it is water (Landmark81Zones.is_in_water via the map's zone
# script), too steep, or the largest enemy capsule (plus BAKE_PAD) hits a scene obstacle
# there (RouteClearance.build_obstacles: the same trimesh sweep that checks routes).
# Bridges have no collision and sit over water, so their deck corridors are forced
# walkable and give the route its y. A* (AStarGrid2D, 8 neighbours, no corner cutting)
# runs once per spawn cell, the path is straightened by line of sight and resampled
# to ~RESAMPLE_STEP, and it comes back in the route format HungryGhost.follow_route()
# walks: {points, dirs, lengths, yaws, scale, wet, airborne, telegraph}. The route ends
# on the lawn's edge, where the ghost's normal march / seek / eat takes over.
# No per-frame work: the grid is read once per map load.

const SURFACE_LIFT: float = 0.07
const RESAMPLE_STEP: float = 1.0
const LOS_STEP: float = 0.5
## How far outside the lawn rect a route ends.
const LAWN_PAD: float = 2.0
## Extra clearance baked around the largest enemy capsule. A walkable cell only proves its
## CENTRE is clear; a path may cut a cell's corner (up to 0.71 m off), so the pad is above
## that and the straightened route still clears the capsule RouteClearance sweeps.
const BAKE_PAD: float = 0.8
## A neighbouring cell more than this higher or lower is a cliff, not a slope.
const MAX_STEP: float = 1.2
const NO_CELL := Vector2i(-1, -1)

var _map: MapDefinition = null
var _zones = null # the map's zone script (MapZones contract), for is_in_water
var _nav_path: String = ""
var _grid_path: String = ""
var _cell: float = 1.0
var _x0: float = 0.0
var _z0: float = 0.0
var _nx: int = 0
var _nz: int = 0
var _walk := PackedByteArray()
var _reach := PackedByteArray() # 1 = walkable AND connected to the lawn edge (spawn cells come from here)
var _regions: Dictionary = {} # name -> Rect2 (x, z, w, d)
var _region_names := PackedStringArray()
var _bridges: Array[Dictionary] = [] # {name, half_w, deck: PackedVector3Array}
var _hash_inputs := PackedStringArray()
var _astar: AStarGrid2D = null
var _routes: Dictionary = {} # start cell -> route
var _problems := PackedStringArray()
var _grid_hash: String = ""


## Parses nav.json and, when present, nav_grid.json. A map with no nav_path gets an empty
## grid (is_empty()) and keeps its old spawn behaviour.
static func from_path(map: MapDefinition, nav_path: String) -> NavGrid:
	var nav := NavGrid.new()
	nav._map = map
	nav._zones = MapZones.for_node(map)
	nav._nav_path = nav_path
	if nav_path.is_empty():
		return nav
	nav._grid_path = nav_path.get_base_dir().path_join("nav_grid.json")
	nav._parse()
	nav._load_grid()
	nav._check_levels()
	return nav


func is_empty() -> bool:
	return _regions.is_empty() or _astar == null


func region_names() -> PackedStringArray:
	return _region_names


func has_region(region: String) -> bool:
	return _regions.has(region)


func region_rect(region: String) -> Rect2:
	return _regions.get(region, Rect2())


func problems() -> PackedStringArray:
	return _problems


func grid_size() -> Vector2i:
	return Vector2i(_nx, _nz)


func is_walkable(x: float, z: float) -> bool:
	return _is_walk_cell(_to_cell(Vector2(x, z)))


## A walkable spawn point inside `region` (random tries, then the walkable cell nearest
## its centre). Vector2(NAN, NAN) when the grid has no such region.
func sample_spawn(region: String, rng: RandomNumberGenerator) -> Vector2:
	if not _regions.has(region) or _astar == null:
		return Vector2(NAN, NAN)
	var rect: Rect2 = _regions[region]
	for attempt in 24:
		var p := Vector2(rng.randf_range(rect.position.x, rect.end.x), rng.randf_range(rect.position.y, rect.end.y))
		if _is_reach_cell(_to_cell(p)):
			return p
	var c := _nearest_reach(_to_cell(rect.get_center()))
	return _cell_center(c) if c != NO_CELL else Vector2(NAN, NAN)


## How many cells of `region` an enemy can spawn on (walkable and connected to the lawn).
func spawn_cells(region: String) -> int:
	if not _regions.has(region):
		return 0
	var rect: Rect2 = _regions[region]
	var c0 := _to_cell(rect.position)
	var c1 := _to_cell(rect.end)
	var n := 0
	for cz in range(c0.y, c1.y + 1):
		for cx in range(c0.x, c1.x + 1):
			if _is_reach_cell(Vector2i(cx, cz)):
				n += 1
	return n


## The route from `from_xz` to the lawn edge, or {} when there is none.
func find_route(from_xz: Vector2) -> Dictionary:
	if _astar == null:
		return {}
	var start := _nearest_reach(_to_cell(from_xz))
	if start == NO_CELL:
		return {}
	if _routes.has(start):
		return _routes[start]
	var goal := _nearest_walkable(_to_cell(_lawn_edge_point(_cell_center(start))))
	if goal == NO_CELL:
		return {}
	var ids: Array[Vector2i] = _astar.get_id_path(start, goal)
	if ids.size() < 2:
		return {}
	var pts := PackedVector2Array()
	for id in ids:
		pts.append(_cell_center(id))
	var route := _build_route(_straighten(pts))
	_routes[start] = route
	return route


# ========================================================
# PARSING / LOADING
# ========================================================

func _parse() -> void:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(_nav_path))
	if not (parsed is Dictionary):
		_problems.append("%s: missing or not a JSON object" % _nav_path)
		return
	var d: Dictionary = parsed
	_cell = float(d.get("cell", 1.0))
	var b: Array = d.get("bounds", [])
	if b.size() < 4 or _cell <= 0.0:
		_problems.append("%s: needs \"cell\" > 0 and \"bounds\" [x0, z0, x1, z1]" % _nav_path)
		return
	_x0 = float(b[0])
	_z0 = float(b[1])
	_nx = int(ceil((float(b[2]) - _x0) / _cell))
	_nz = int(ceil((float(b[3]) - _z0) / _cell))
	for name in (d.get("regions", {}) as Dictionary):
		var r: Array = (d["regions"] as Dictionary)[name]
		if r.size() < 4:
			_problems.append("%s: region \"%s\" needs [x, z, w, d]" % [_nav_path, name])
			continue
		_regions[str(name)] = Rect2(float(r[0]), float(r[1]), float(r[2]), float(r[3]))
		_region_names.append(str(name))
	_region_names.sort()
	for bridge in d.get("bridges", []):
		var deck := PackedVector3Array()
		for p in (bridge as Dictionary).get("deck", []):
			deck.append(Vector3(float(p[0]), float(p[2]), float(p[1])))
		if deck.size() < 2:
			_problems.append("%s: bridge \"%s\" needs a deck of at least 2 [x, z, y] points" % [_nav_path, str((bridge as Dictionary).get("name", "?"))])
			continue
		_bridges.append({"name": str((bridge as Dictionary).get("name", "")), "half_w": float((bridge as Dictionary).get("half_w", 1.2)), "deck": deck})
	for path in d.get("hash_inputs", []):
		_hash_inputs.append(str(path))


func _load_grid() -> void:
	if _nx <= 0 or not FileAccess.file_exists(_grid_path):
		_problems.append("%s missing: run `-- --nav-bake` on this map and commit it" % _grid_path)
		return
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(_grid_path))
	if not (parsed is Dictionary):
		_problems.append("%s is not a JSON object: re-run `-- --nav-bake`" % _grid_path)
		return
	var rows: Array = (parsed as Dictionary).get("rows", [])
	if rows.size() != _nz or (rows.size() > 0 and str(rows[0]).length() != _nx):
		_problems.append("%s is %d x %d but nav.json bounds make %d x %d: re-run `-- --nav-bake`" % [
			_grid_path, str(rows[0]).length() if rows.size() > 0 else 0, rows.size(), _nx, _nz])
		return
	_grid_hash = str((parsed as Dictionary).get("hash", ""))
	if _grid_hash != inputs_hash():
		_problems.append("%s is stale (nav.json, the scene or a map data file changed): re-run `-- --nav-bake` and commit it" % _grid_path)
	_walk.resize(_nx * _nz)
	for z in _nz:
		var row := str(rows[z])
		for x in _nx:
			_walk[z * _nx + x] = 1 if row.unicode_at(x) == 49 else 0
	_build_astar()
	_build_reach()
	_check_regions()


func _build_astar() -> void:
	_astar = AStarGrid2D.new()
	_astar.region = Rect2i(0, 0, _nx, _nz)
	_astar.cell_size = Vector2.ONE
	_astar.diagonal_mode = AStarGrid2D.DIAGONAL_MODE_ONLY_IF_NO_OBSTACLES
	_astar.default_compute_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	_astar.default_estimate_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	_astar.update()
	for z in _nz:
		for x in _nx:
			if _walk[z * _nx + x] == 0:
				_astar.set_point_solid(Vector2i(x, z), true)


## Flood fill (4-neighbour) from the walkable cell nearest each side of the padded lawn:
## a walkable pocket the lawn cannot be reached from (a fenced corner, a gazebo ring)
## must never be a spawn cell, or that enemy would stand there for ever.
func _build_reach() -> void:
	_reach.resize(_nx * _nz)
	var lawn := _map.lawn_rect("").grow(LAWN_PAD)
	var stack: Array[Vector2i] = []
	for seed_p in [Vector2(lawn.position.x, lawn.get_center().y), Vector2(lawn.end.x, lawn.get_center().y),
			Vector2(lawn.get_center().x, lawn.position.y), Vector2(lawn.get_center().x, lawn.end.y)]:
		var c := _nearest_walkable(_to_cell(seed_p))
		if c != NO_CELL and _reach[c.y * _nx + c.x] == 0:
			_reach[c.y * _nx + c.x] = 1
			stack.append(c)
	while not stack.is_empty():
		var cur: Vector2i = stack.pop_back()
		for off in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
			var n: Vector2i = cur + off
			if _is_walk_cell(n) and _reach[n.y * _nx + n.x] == 0:
				_reach[n.y * _nx + n.x] = 1
				stack.append(n)


func _is_reach_cell(c: Vector2i) -> bool:
	return _is_walk_cell(c) and _reach.size() == _nx * _nz and _reach[c.y * _nx + c.x] == 1


## Hash of nav.json and every file it names in "hash_inputs": the grid is only as fresh
## as the lagoon, the scene and the tree/prop data it was baked from.
func inputs_hash() -> String:
	var acc := FileAccess.get_sha256(_nav_path)
	for path in _hash_inputs:
		acc += FileAccess.get_sha256(path) if FileAccess.file_exists(path) else "missing:" + path
	return acc.sha256_text()


## Every region must reach the lawn from a few points, and every bridge end must be on
## walkable ground: a region the grid cannot leave would spawn enemies that never walk.
func _check_regions() -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = 1
	for name in _region_names:
		if spawn_cells(name) == 0:
			_problems.append("nav region \"%s\" has no walkable cell connected to the lawn in %s" % [name, str(_regions[name])])
			continue
		for attempt in 4:
			var p := sample_spawn(name, rng)
			if find_route(p).is_empty():
				_problems.append("nav region \"%s\": no route to the lawn from (%.1f, %.1f)" % [name, p.x, p.y])
	for bridge in _bridges:
		var deck: PackedVector3Array = bridge["deck"]
		for end in [deck[0], deck[deck.size() - 1]]:
			if not _is_walk_cell(_to_cell(Vector2(end.x, end.z))):
				_problems.append("nav bridge \"%s\": deck end (%.1f, %.1f) is not walkable" % [bridge["name"], end.x, end.z])


## Every level on this map may only name a nav region as its group "zone", and the retired
## "gate" field must be gone: an unknown zone would silently round-robin every region.
func _check_levels() -> void:
	if _map == null or _map.map_id.is_empty() or not LevelDB:
		return
	for world in LevelDB.get_worlds():
		for level in LevelDB.get_levels(str(world.get("id", ""))):
			var level_id := str(level.get("id", ""))
			if LevelDB.resolve_map(level_id) != _map.map_id:
				continue
			for wave in level.get("waves", []):
				for group in (wave as Dictionary).get("spawns", []):
					var spawn: Dictionary = group
					var zone := str(spawn.get("zone", ""))
					if not zone.is_empty() and not _regions.has(zone):
						_problems.append("level %s names zone \"%s\", which is not a nav region of %s (%s)" % [level_id, zone, _map.map_id, ", ".join(_region_names)])
					if spawn.has("gate"):
						_problems.append("level %s still has a \"gate\" field; spawn gates were replaced by nav regions (use \"zone\" or nothing)" % level_id)


# ========================================================
# GRID MATH
# ========================================================

func _to_cell(p: Vector2) -> Vector2i:
	return Vector2i(clampi(floori((p.x - _x0) / _cell), 0, _nx - 1), clampi(floori((p.y - _z0) / _cell), 0, _nz - 1))


func _cell_center(c: Vector2i) -> Vector2:
	return Vector2(_x0 + (c.x + 0.5) * _cell, _z0 + (c.y + 0.5) * _cell)


func _is_walk_cell(c: Vector2i) -> bool:
	return c.x >= 0 and c.y >= 0 and c.x < _nx and c.y < _nz and _walk.size() == _nx * _nz and _walk[c.y * _nx + c.x] == 1


## `c` itself when walkable, else the nearest walkable cell within 12 rings.
func _nearest_walkable(c: Vector2i) -> Vector2i:
	if _is_walk_cell(c):
		return c
	for ring in range(1, 13):
		var best := NO_CELL
		var best_d := INF
		for dz in range(-ring, ring + 1):
			for dx in range(-ring, ring + 1):
				if maxi(absi(dx), absi(dz)) != ring:
					continue
				var n := Vector2i(c.x + dx, c.y + dz)
				if _is_walk_cell(n) and float(dx * dx + dz * dz) < best_d:
					best_d = float(dx * dx + dz * dz)
					best = n
		if best != NO_CELL:
			return best
	return NO_CELL


## Like _nearest_walkable, but only cells connected to the lawn.
func _nearest_reach(c: Vector2i) -> Vector2i:
	if _is_reach_cell(c):
		return c
	for ring in range(1, 13):
		var best := NO_CELL
		var best_d := INF
		for dz in range(-ring, ring + 1):
			for dx in range(-ring, ring + 1):
				if maxi(absi(dx), absi(dz)) != ring:
					continue
				var n := Vector2i(c.x + dx, c.y + dz)
				if _is_reach_cell(n) and float(dx * dx + dz * dz) < best_d:
					best_d = float(dx * dx + dz * dz)
					best = n
		if best != NO_CELL:
			return best
	return NO_CELL


## The point on the (padded) lawn rect nearest to `p`; `p` itself when already inside.
func _lawn_edge_point(p: Vector2) -> Vector2:
	var lawn := _map.lawn_rect("").grow(LAWN_PAD)
	if lawn.has_point(p):
		return p
	return Vector2(clampf(p.x, lawn.position.x, lawn.end.x), clampf(p.y, lawn.position.y, lawn.end.y))


# ========================================================
# PATH -> ROUTE
# ========================================================

func _line_clear(a: Vector2, b: Vector2) -> bool:
	var steps := maxi(1, int(ceil(a.distance_to(b) / LOS_STEP)))
	for i in range(1, steps):
		if not _is_walk_cell(_to_cell(a.lerp(b, float(i) / float(steps)))):
			return false
	return true


## Greedy string pulling: from each kept point, jump to the farthest one it can see.
func _straighten(pts: PackedVector2Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	out.append(pts[0])
	var i := 0
	while i < pts.size() - 1:
		var j := pts.size() - 1
		while j > i + 1 and not _line_clear(pts[i], pts[j]):
			j -= 1
		out.append(pts[j])
		i = j
	return out


## Deck height under (x, z) when it is on a bridge corridor, else NAN.
func _deck_y(x: float, z: float) -> float:
	for bridge in _bridges:
		var deck: PackedVector3Array = bridge["deck"]
		var half_w: float = bridge["half_w"]
		var p := Vector2(x, z)
		for i in deck.size() - 1:
			var a := Vector2(deck[i].x, deck[i].z)
			var b := Vector2(deck[i + 1].x, deck[i + 1].z)
			var ab := b - a
			var t := clampf((p - a).dot(ab) / maxf(ab.dot(ab), 1e-6), 0.0, 1.0)
			if p.distance_to(a + ab * t) <= half_w:
				return lerpf(deck[i].y, deck[i + 1].y, t)
	return NAN


func _surface_y(x: float, z: float) -> float:
	var deck := _deck_y(x, z)
	return deck if not is_nan(deck) else _map.ground_y_at(x, z) + SURFACE_LIFT


func _build_route(poly: PackedVector2Array) -> Dictionary:
	var points := PackedVector3Array()
	var wet := PackedByteArray()
	var first := poly[0]
	points.append(Vector3(first.x, _surface_y(first.x, first.y), first.y))
	wet.append(1 if not is_nan(_deck_y(first.x, first.y)) else 0)
	for i in poly.size() - 1:
		var a := poly[i]
		var b := poly[i + 1]
		var steps := maxi(1, int(ceil(a.distance_to(b) / RESAMPLE_STEP)))
		for s in range(1, steps + 1):
			var p := a.lerp(b, float(s) / float(steps))
			points.append(Vector3(p.x, _surface_y(p.x, p.y), p.y))
			wet.append(1 if not is_nan(_deck_y(p.x, p.y)) else 0)
	var dirs := PackedVector3Array()
	var lengths := PackedFloat32Array()
	var yaws := PackedFloat32Array()
	for i in points.size() - 1:
		var d := points[i + 1] - points[i]
		lengths.append(d.length())
		var dir := d.normalized()
		dirs.append(dir)
		yaws.append(atan2(dir.x, dir.z))
	var air := PackedByteArray()
	air.resize(points.size())
	return {"points": points, "dirs": dirs, "lengths": lengths, "yaws": yaws, "scale": 1.0,
		"wet": wet, "airborne": air, "telegraph": "mound"}


# ========================================================
# SAMPLING / BRIEFING
# ========================================================

## A deterministic spread of routes (`per_region` spawn points per region) as RouteClearance
## sweep entries: what --round-test and --nav-test check against the scene.
func sample_routes(per_region: int) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	if _astar == null:
		return out
	var rng := RandomNumberGenerator.new()
	rng.seed = 20261005
	for region in _region_names:
		for i in per_region:
			var p := sample_spawn(region, rng)
			if is_nan(p.x):
				continue
			var route := find_route(p)
			if not route.is_empty():
				out.append(RouteClearance.sweep_entry(region, i, route))
	return out


## The regions a level's waves can use: every group's "zone" that names a region, or all
## of them when some group names none (it round-robins).
func active_regions(level: Dictionary) -> PackedStringArray:
	var out := PackedStringArray()
	var any_open := false
	for wave in level.get("waves", []):
		for group in (wave as Dictionary).get("spawns", []):
			var zone := str((group as Dictionary).get("zone", ""))
			if zone.is_empty():
				any_open = true
			elif has_region(zone) and not out.has(zone):
				out.append(zone)
	return _region_names.duplicate() if any_open or out.is_empty() else out


const BRIEFING_AREA_COLOR := Color(1.0, 0.62, 0.18, 0.5)
const BRIEFING_ARROW_COLOR := Color(1.0, 0.78, 0.40, 0.95)
const BRIEFING_LIFT: float = 0.12
const BRIEFING_ARROWS: int = 3 # chevrons per region, pointing at the lawn
const BRIEFING_ARROW_GAP: float = 4.0 # m between chevrons
const BRIEFING_ARROW_SIZE: float = 1.6 # m, half width and length of a chevron


## Briefing highlight: one MeshInstance3D (ImmediateMesh triangles, unshaded, cast_shadow
## OFF) holding, per active region, every walkable lawn-connected cell of the region as a
## translucent amber quad (the area enemies can surface in) and a few chevrons pointing
## toward the lawn. One material, vertex colours for the two alphas; it ignores fog and
## depth so it reads from the far scouting camera. These are areas, NOT paths: every
## enemy gets its own route from its own spawn cell. queue_free() it on confirm so battle
## is +0 draw calls. Built once; no per-frame work.
func briefing_draw(parent: Node3D, regions: PackedStringArray) -> MeshInstance3D:
	if is_empty() or parent == null or regions.is_empty():
		return null
	var mi := MeshInstance3D.new()
	mi.name = "BriefingRegions"
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var mat := StandardMaterial3D.new()
	mat.shading_mode = StandardMaterial3D.SHADING_MODE_UNSHADED
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.vertex_color_use_as_albedo = true
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mat.no_depth_test = true
	mat.disable_fog = true
	mi.material_override = mat
	var im := ImmediateMesh.new()
	mi.mesh = im
	parent.add_child(mi)
	var lawn_center := _map.lawn_rect("").get_center()
	im.surface_begin(Mesh.PRIMITIVE_TRIANGLES)
	for region in regions:
		if not has_region(region):
			continue
		var rect: Rect2 = _regions[region]
		_area(im, rect)
		var c := _nearest_reach(_to_cell(rect.get_center()))
		if c != NO_CELL:
			_arrows(im, _cell_center(c), lawn_center)
	im.surface_end()
	return mi


## Every lawn-connected walkable cell of `rect` as a flat quad on the ground.
func _area(im: ImmediateMesh, rect: Rect2) -> void:
	var c0 := _to_cell(rect.position)
	var c1 := _to_cell(rect.end)
	im.surface_set_color(BRIEFING_AREA_COLOR)
	for cz in range(c0.y, c1.y + 1):
		for cx in range(c0.x, c1.x + 1):
			var c := Vector2i(cx, cz)
			if not _is_reach_cell(c):
				continue
			var p := _cell_center(c)
			var y := _map.ground_y_at(p.x, p.y) + BRIEFING_LIFT
			var h := _cell * 0.5
			_quad(im, Vector3(p.x - h, y, p.y - h), Vector3(p.x + h, y, p.y - h),
				Vector3(p.x + h, y, p.y + h), Vector3(p.x - h, y, p.y + h))


## A short row of chevrons from `from` toward `to`, all on the ground.
func _arrows(im: ImmediateMesh, from: Vector2, to: Vector2) -> void:
	var dir := to - from
	if dir.length_squared() < 0.0001:
		return
	dir = dir.normalized()
	var fwd := Vector3(dir.x, 0.0, dir.y)
	var side := fwd.cross(Vector3.UP) * BRIEFING_ARROW_SIZE
	im.surface_set_color(BRIEFING_ARROW_COLOR)
	for i in BRIEFING_ARROWS:
		var p := from + dir * (float(i) * BRIEFING_ARROW_GAP)
		var base := Vector3(p.x, _map.ground_y_at(p.x, p.y) + BRIEFING_LIFT + 0.02, p.y)
		var tip := base + fwd * BRIEFING_ARROW_SIZE
		var back := base - fwd * BRIEFING_ARROW_SIZE * 0.4
		im.surface_add_vertex(back - side)
		im.surface_add_vertex(tip)
		im.surface_add_vertex(back + side)


func _quad(im: ImmediateMesh, a: Vector3, b: Vector3, c: Vector3, d: Vector3) -> void:
	im.surface_add_vertex(a)
	im.surface_add_vertex(b)
	im.surface_add_vertex(c)
	im.surface_add_vertex(a)
	im.surface_add_vertex(c)
	im.surface_add_vertex(d)


# ========================================================
# BAKE (-- --nav-bake)
# ========================================================

## Samples every cell of the bounds against the loaded scene and writes nav_grid.json.
## Returns the number of walkable cells (0 on failure). A coroutine: the physics server
## needs frames to register the temporary obstacle bodies.
func bake() -> int:
	if DisplayServer.get_name() == "headless":
		push_error("[NavGrid] bake: run with a window (not --headless): the dummy renderer keeps no MultiMesh instance data, so every tree would be baked at the origin")
		return 0
	if _nx <= 0 or _nz <= 0:
		push_error("[NavGrid] bake: %s has no usable bounds" % _nav_path)
		return 0
	var tree := _map.get_tree()
	var capsule := RouteClearance.largest_enemy_capsule()
	if capsule.x <= 0.0 or capsule.y <= 0.0:
		push_error("[NavGrid] bake: no enemy CollisionShape3D found")
		return 0
	var t0 := Time.get_ticks_msec()
	var bounds := Rect2(_x0, _z0, _nx * _cell, _nz * _cell)
	var built := RouteClearance.build_obstacles(_map, bounds)
	for i in RouteClearance.SETTLE_FRAMES:
		await tree.physics_frame
	var obstacles: Dictionary = built["obstacles"]
	var space := _map.get_world_3d().direct_space_state
	var shape := CapsuleShape3D.new()
	shape.radius = capsule.x * 0.5 + BAKE_PAD
	shape.height = maxf(capsule.y, shape.radius * 2.0 + 0.01)
	var query := PhysicsShapeQueryParameters3D.new()
	query.shape = shape
	query.collision_mask = RouteClearance.SWEEP_LAYER
	var walk := PackedByteArray()
	walk.resize(_nx * _nz)
	var count := 0
	for cz in _nz:
		for cx in _nx:
			var p := _cell_center(Vector2i(cx, cz))
			var ok := _bake_cell_ok(p, space, query, shape, obstacles)
			if not is_nan(_deck_y(p.x, p.y)):
				ok = true # a bridge deck corridor: no collision, over water, rails beside it
			walk[cz * _nx + cx] = 1 if ok else 0
			if ok:
				count += 1
	for body in built["bodies"]:
		if is_instance_valid(body):
			(body as Node).queue_free()
	var rows: Array = []
	for cz in _nz:
		var row := ""
		for cx in _nx:
			row += "1" if walk[cz * _nx + cx] == 1 else "0"
		rows.append(row)
	_walk = walk
	var out := {"generated_by": "src/maps/NavGrid.gd (-- --nav-bake)", "hash": inputs_hash(), "cell": _cell, "rows": rows}
	var f := FileAccess.open(_grid_path, FileAccess.WRITE)
	if f == null:
		push_error("[NavGrid] bake: cannot write %s" % _grid_path)
		return 0
	f.store_string(JSON.stringify(out) + "\n")
	f.close()
	print("[NavGrid] baked %d x %d cells (%d walkable, %d obstacle bodies) in %d ms -> %s" % [
		_nx, _nz, count, (built["bodies"] as Array).size(), Time.get_ticks_msec() - t0, _grid_path])
	return count


## Walkable by the data and the sweep: dry, not a cliff, nothing taller than a kerb in
## the capsule's way.
func _bake_cell_ok(p: Vector2, space: PhysicsDirectSpaceState3D, query: PhysicsShapeQueryParameters3D, shape: CapsuleShape3D, obstacles: Dictionary) -> bool:
	if bool(_zones.is_in_water(p.x, p.y)):
		return false
	var y := _map.ground_y_at(p.x, p.y)
	for off in [Vector2(_cell, 0.0), Vector2(-_cell, 0.0), Vector2(0.0, _cell), Vector2(0.0, -_cell)]:
		if absf(_map.ground_y_at(p.x + off.x, p.y + off.y) - y) > MAX_STEP:
			return false
	query.transform = Transform3D(Basis.IDENTITY, Vector3(p.x, y + RouteClearance.CLEARANCE + shape.height * 0.5, p.y))
	for r in space.intersect_shape(query, 16):
		var top := RouteClearance.obstacle_top(r, obstacles)
		if top > y + RouteClearance.STEP_UP:
			return false
	return true
