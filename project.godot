; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Leyline Warden: Interactive Presentation"
config/description="Interactive presentation build of Leyline Warden: Spirits of the Soil."
run/main_scene="res://src/core/Boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="LeylineWardenPresentation"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
boot_splash/bg_color=Color(0.02, 0.025, 0.04, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Net="*res://src/net/Net.gd"
EventBus="*res://src/core/EventBus.gd"
GameManager="*res://src/core/GameManager.gd"
BalanceDB="*res://src/core/BalanceDB.gd"
LevelDB="*res://src/core/LevelDB.gd"
Progress="*res://src/core/Progress.gd"
GameFlow="*res://src/core/GameFlow.gd"
Audio="*res://src/core/Audio.gd"
GameSettings="*res://src/core/GameSettings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

